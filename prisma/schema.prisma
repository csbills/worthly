generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PluggyItem {
  id        String   @id @default(cuid())
  itemId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ManualCryptoAsset {
  id            String   @id @default(cuid())
  symbol        String
  name          String
  quantity      Float
  averagePrice  Float?
  currentPrice  Float?
  purchaseTotal Float?
  brokerFee     Float    @default(0)
  purchasePrice Float?
  currencyCode  String   @default("BRL")
  coingeckoId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        ManualCryptoOrder[]

  @@unique([symbol, currencyCode])
  @@index([coingeckoId])
  @@index([currencyCode])
}

model ManualCryptoOrder {
  id        String            @id @default(cuid())
  assetId   String
  side      String
  orderDate DateTime
  total     Float
  brokerFee Float             @default(0)
  unitPrice Float
  quantity  Float
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  asset     ManualCryptoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, orderDate])
  @@index([orderDate])
}

model PortfolioSnapshot {
  id              String                    @id @default(cuid())
  snapshotDate    String
  capturedAt      DateTime                  @default(now())
  currencyCode    String
  balance         Float
  amountOriginal  Float?
  amountProfit    Float?
  categories      PortfolioSnapshotCategory[]

  @@unique([snapshotDate, currencyCode])
  @@index([currencyCode, snapshotDate])
}

model PortfolioSnapshotCategory {
  id              String           @id @default(cuid())
  snapshotId      String
  categoryKey     String
  balance         Float
  amountOriginal  Float?
  amountProfit    Float?
  assetCount      Int              @default(0)
  snapshot        PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, categoryKey])
  @@index([snapshotId])
}
