generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PluggyItem {
  id                String   @id @default(cuid())
  itemId            String   @unique
  connectorName     String?
  connectorImageUrl String?
  status            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Singleton row (id "default") with the instance configuration collected by
/// the onboarding. Credentials stay server-side and are never sent back.
model AppSettings {
  id                    String    @id @default("default")
  pluggyClientId        String?
  pluggyClientSecret    String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PortfolioSnapshot {
  id              String                    @id @default(cuid())
  snapshotDate    String
  capturedAt      DateTime                  @default(now())
  currencyCode    String
  balance         Float
  amountOriginal  Float?
  amountProfit    Float?
  categories      PortfolioSnapshotCategory[]

  @@unique([snapshotDate, currencyCode])
  @@index([currencyCode, snapshotDate])
}

model PortfolioSnapshotCategory {
  id              String           @id @default(cuid())
  snapshotId      String
  categoryKey     String
  balance         Float
  amountOriginal  Float?
  amountProfit    Float?
  assetCount      Int              @default(0)
  snapshot        PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, categoryKey])
  @@index([snapshotId])
}

model NetWorthSnapshot {
  id                String   @id @default(cuid())
  snapshotDate      String   @unique
  capturedAt        DateTime @default(now())
  currencyCode      String   @default("BRL")
  accountBalance    Float
  investmentBalance Float
  creditUsed        Float
  netWorth          Float

  @@index([snapshotDate])
}

model User {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  passkeys     Passkey[]
}

/// Server-side sessions. Only a SHA-256 of the cookie token is stored, so a
/// leaked database cannot be replayed as a login.
model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  expiresAt    DateTime
  /// Last request made while unlocked. With passkeys set up, a session idle
  /// for a few minutes (the app went to the background) asks for one again.
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// WebAuthn credentials (Face ID, Touch ID, Android biometrics). Only the
/// public key is stored; the private key never leaves the device.
model Passkey {
  id           String    @id @default(cuid())
  /// Base64URL credential ID, as the browser reports it.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  /// Comma-separated AuthenticatorTransport values ("internal,hybrid").
  transports   String    @default("")
  /// Synced (iCloud Keychain, Google Password Manager) or bound to one device.
  backedUp     Boolean   @default(false)
  name         String
  userId       String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
