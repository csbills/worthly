generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PluggyItem {
  id                String           @id @default(cuid())
  itemId            String           @unique
  connectorName     String?
  connectorImageUrl String?
  status            String?
  /// De quem é este banco (você, sua esposa…). Opcional.
  memberId          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  member            HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

/// Uma pessoa da casa cujas contas entram no Worthly. Serve para separar
/// renda e gastos por pessoa; o login continua sendo um só.
model HouseholdMember {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     PluggyItem[]
}

/// Singleton row (id "default") with the instance configuration collected by
/// the onboarding. Credentials stay server-side and are never sent back.
model AppSettings {
  id                    String    @id @default("default")
  pluggyClientId        String?
  pluggyClientSecret    String?
  /// Chave da API da Anthropic para o assistente (Tito). Opcional: sem ela
  /// o assistente fica desligado. Nunca volta para o navegador.
  anthropicApiKey       String?
  /// SHA-256 do token do servidor MCP (Claude Desktop e outros clientes). O
  /// token em si só aparece uma vez, na hora em que é criado.
  mcpTokenHash          String?
  mcpTokenCreatedAt     DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PortfolioSnapshot {
  id              String                    @id @default(cuid())
  snapshotDate    String
  capturedAt      DateTime                  @default(now())
  currencyCode    String
  balance         Float
  amountOriginal  Float?
  amountProfit    Float?
  categories      PortfolioSnapshotCategory[]

  @@unique([snapshotDate, currencyCode])
  @@index([currencyCode, snapshotDate])
}

model PortfolioSnapshotCategory {
  id              String           @id @default(cuid())
  snapshotId      String
  categoryKey     String
  balance         Float
  amountOriginal  Float?
  amountProfit    Float?
  assetCount      Int              @default(0)
  snapshot        PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, categoryKey])
  @@index([snapshotId])
}

model NetWorthSnapshot {
  id                String   @id @default(cuid())
  snapshotDate      String   @unique
  capturedAt        DateTime @default(now())
  currencyCode      String   @default("BRL")
  accountBalance    Float
  investmentBalance Float
  creditUsed        Float
  netWorth          Float

  @@index([snapshotDate])
}

model User {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  passkeys     Passkey[]
}

/// Server-side sessions. Only a SHA-256 of the cookie token is stored, so a
/// leaked database cannot be replayed as a login.
model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  expiresAt    DateTime
  /// Last request made while unlocked. With passkeys set up, a session idle
  /// for a few minutes (the app went to the background) asks for one again.
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// WebAuthn credentials (Face ID, Touch ID, Android biometrics). Only the
/// public key is stored; the private key never leaves the device.
model Passkey {
  id           String    @id @default(cuid())
  /// Base64URL credential ID, as the browser reports it.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  /// Comma-separated AuthenticatorTransport values ("internal,hybrid").
  transports   String    @default("")
  /// Synced (iCloud Keychain, Google Password Manager) or bound to one device.
  backedUp     Boolean   @default(false)
  name         String
  userId       String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ajustes do usuário sobre uma transação lida da Pluggy (pelo id dela). A
/// Pluggy continua sendo a fonte dos lançamentos; aqui fica só o que é seu:
/// a categoria escolhida, uma nota e se ela entra nos relatórios.
model TransactionOverride {
  transactionId String   @id
  /// Id do dicionário de categorias da Pluggy (ex.: "11010000").
  categoryId    String?
  note          String?
  /// Fora dos totais, gráficos e orçamentos (ex.: reembolso, transferência).
  ignored       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// "Sempre que a descrição contiver X, use a categoria Y." Vale para
/// lançamentos antigos e novos; um ajuste manual da transação tem prioridade.
model CategoryRule {
  id         String   @id @default(cuid())
  /// Trecho procurado na descrição, sem diferenciar maiúsculas e acentos.
  pattern    String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

/// Uma conversa com o Tito, o assistente.
model AssistantConversation {
  id        String             @id @default(cuid())
  title     String
  /// Agente usado na conversa; as instruções dele valem em todos os turnos.
  agentId   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]
  agent     AssistantAgent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

/// Um "Tito especialista": instruções fixas para um foco (uma meta, uma
/// categoria, um hábito) que entram em toda conversa iniciada com ele.
model AssistantAgent {
  id            String                  @id @default(cuid())
  name          String
  emoji         String                  @default("🤖")
  instructions  String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  conversations AssistantConversation[]
}

/// Uma mensagem da API, guardada exatamente como foi enviada ou recebida
/// (blocos de conteúdo em JSON). O histórico só cresce: blocos de raciocínio
/// precisam voltar intactos nas próximas chamadas.
model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime              @default(now())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Limite mensal de gastos para um grupo de categorias (a raiz do dicionário,
/// ex.: "11000000" Alimentação). Vale para todos os meses até ser alterado.
model Budget {
  id              String   @id @default(cuid())
  categoryGroupId String   @unique
  amount          Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Uma meta de economia: quanto juntar, até quando e quanto já foi guardado.
model Goal {
  id           String    @id @default(cuid())
  name         String
  emoji        String    @default("🎯")
  targetAmount Float
  savedAmount  Float     @default(0)
  targetDate   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
}

/// Contexto da família para o plano (linha única "default"): quem vive da
/// renda, estabilidade, idade e o objetivo de longo prazo.
model FinancialProfile {
  id                    String   @id @default("default")
  /// single | couple | family
  householdType         String   @default("couple")
  dependents            Int      @default(0)
  /// stable (CLT, servidor) | variable (autônomo, comissão)
  incomeStability       String   @default("stable")
  /// Quantas rendas sustentam a casa.
  incomeEarners         Int      @default(1)
  birthYear             Int?
  /// independence | home | debt-free | education | travel
  mainGoal              String   @default("independence")
  /// Idade em que quer poder parar de depender do trabalho.
  targetIndependenceAge Int?
  /// Custo de vida mensal desejado nessa fase, em reais de hoje. Vazio: o
  /// gasto típico atual sem os compromissos que vão terminar.
  desiredMonthlyCost    Float?
  /// Retorno anual acima da inflação (%), usado nas projeções.
  expectedRealReturn    Float    @default(4)
  /// Quanto do patrimônio retirar por ano na independência (%).
  withdrawalRate        Float    @default(4)
  /// Meses de reserva de emergência; vazio usa a recomendação do plano.
  emergencyMonths       Int?
  /// Contexto livre para o Tito ("queremos ter um filho em 2028").
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Compromisso fixo que pesa no orçamento: financiamento, empréstimo,
/// aluguel, escola, pensão. Quando tem data de fim, o plano sabe quando esse
/// dinheiro volta a ficar livre.
model Obligation {
  id            String   @id @default(cuid())
  name          String
  /// financing | loan | rent | education | alimony | other
  kind          String   @default("other")
  monthlyAmount Float
  /// Último mês de pagamento (YYYY-MM); vazio = sem data para acabar.
  endMonth      String?
  /// Saldo devedor atual, quando houver.
  balance       Float?
  /// Juros ao ano (%), para comparar amortizar com investir.
  interestRate  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
