# Pluggy application credentials (server-side only)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Local SQLite database used by Prisma
DATABASE_URL="file:./prisma/dev.db"

# Optional CoinGecko Demo API key (server-side only). Leave empty to use the
# keyless public API while developing.
COINGECKO_API_KEY=
