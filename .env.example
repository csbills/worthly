# Local SQLite database used by Prisma. In production, point it at a
# persistent volume, e.g. file:/data/worthly.db
DATABASE_URL="file:./prisma/dev.db"

# Public URL of this instance, e.g. https://financas.example.com. Passkeys
# (Face ID, Touch ID, Android biometrics) are bound to this domain, so set it
# in production and keep it stable. Leave empty locally: the request host
# (http://localhost:3000) is used.
APP_URL=
