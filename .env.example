# Local SQLite database used by Prisma. In production, point it at a
# persistent volume, e.g. file:/data/worthly.db
DATABASE_URL="file:./prisma/dev.db"

# Public URL of this instance, e.g. https://financas.example.com. Passkeys
# (Face ID, Touch ID, Android biometrics) are bound to this domain, so set it
# in production and keep it stable. Leave empty locally: the request host
# (http://localhost:3000) is used.
APP_URL=

# Optional: the language model behind Tito, the assistant. You can also pick
# it on the assistant screen (that wins over these); keys stay on the server.
# ASSISTANT_PROVIDER: anthropic (default) | deepseek | openai-compatible
ASSISTANT_PROVIDER=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# For openai-compatible (OpenAI, OpenRouter, Ollama…), or to override defaults.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
