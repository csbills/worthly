# Local SQLite database used by Prisma. In production, point it at a
# persistent volume, e.g. file:/data/bytewave.db
DATABASE_URL="file:./prisma/dev.db"

# Optional: Pluggy application credentials (server-side only). You can also
# paste them in the onboarding at /onboarding — saved credentials win.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Optional CoinGecko Demo API key (server-side only). Leave empty to use the
# keyless public API while developing.
COINGECKO_API_KEY=
